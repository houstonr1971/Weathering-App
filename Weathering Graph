    <script>
        // Default Reference Setup
        const CURRENT_YEAR = 2026;

        // Rock visual configurations: pointStyle, dataset color, border style
        const ROCK_CONFIGS = {
            'Granite': {
                shape: 'triangle',
                color: '#ef4444', // Red / Pink granite
                bgColor: 'rgba(239, 68, 68, 0.7)',
                borderDash: []
            },
            'Marble': {
